{
  "name": "Epiow",
  "version": "5.0.0",
  "updated": "2026-11-17",
  "source": "Overlap identity, chosen by Kyle on 2026-11-17. Replaces tokens 3.0.0 (indigo and ember), archived in logo/archive/bracket-and-signal-2026-09/brand.tokens.v3.json.",
  "pending": "Surfaces still ship tokens 3.0.0 until their own changes land (docs/surfaces.md). The Workspace OS tokens v4 proposal (vision/2026-09/os-redesign) was drawn on indigo and ember and needs re-basing on this palette before adoption.",
  "rules": {
    "primary": "Forest carries the brand: forest-900 is the app tile and the primary action colour on light grounds; green-300 is the primary on dark grounds.",
    "signal": "Lime is the signal only: the lens of the mark, agent activity, and at most one key call to action per surface. It is never a hover tint, a border or a background wash.",
    "text_on_signal": "Text on lime is always forest ink (signal-foreground). White on lime measures 1.2:1 and is not allowed. Lime is never text on a light ground (1.1:1 on paper); use signal-text.",
    "gradients": "The logo never uses a gradient."
  },
